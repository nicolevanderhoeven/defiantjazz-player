# Copy to local/.env (git-ignored) to set the Grafana admin login.
# Only applied when Grafana's data volume is first created; see README to change it later.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: require MCP clients to send this as a bearer token.
# MCP_SERVER_TOKEN=

# Optional: move a port if something else on your machine already uses it.
# DJ_GRAFANA_PORT=3000
# DJ_MCP_PORT=8000

# Optional: switch off the traces of your agent's calls (see README, "Watch your agent investigate"). They're on by
# default and go to this stack's own Tempo. Uncomment these two lines, with nothing after the =, to send nothing.
# DJ_MCP_TRACES=
# DJ_GRAFANA_TRACES=
